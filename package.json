{
  "name": "vercises",
  "private": true,
  "scripts": {
    "test:lint": "eslint \"client/src/**/*.{js,jsx}\" \"server/**/*.js\" --ignore-pattern \"server/public/**\" && prettier --check \"client/src/**/*.{js,jsx}\" \"server/**/*.js\" --ignore-path .prettierignore",
    "test:unit:server": "vitest --config vitest.server.config.js run",
    "test:unit:client": "vitest --config vitest.client.config.js run",
    "test:api": "vitest --config vitest.api.config.js run",
    "test:e2e": "playwright test",
    "test": "npm run test:lint && npm run test:unit:server && npm run test:unit:client && npm run test:api && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "dockerode": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "supertest": "^7.0.0",
    "vite": "^5.2.0",
    "vitest": "^2.0.0",
    "wait-on": "^7.2.0"
  }
}
